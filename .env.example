# CYBEROS Environment Configuration Example
# Copy to .env and adjust values. Never commit real secrets.

# Application
CYBEROS_ENV=development
CYBEROS_LOG_LEVEL=info
CYBEROS_LOG_FORMAT=json

# API
CYBEROS_API_ADDR=:8080
CYBEROS_API_READ_TIMEOUT=30s
CYBEROS_API_WRITE_TIMEOUT=30s

# Database (PostgreSQL) — Phase 1+
# CYBEROS_DATABASE_URL=postgres://cyberos:cyberos@localhost:5432/cyberos?sslmode=disable
# CYBEROS_DATABASE_MAX_OPEN_CONNS=25
# CYBEROS_DATABASE_MAX_IDLE_CONNS=5

# Security
# CYBEROS_JWT_SECRET=change-me-in-production
# CYBEROS_EXECUTION_GRANT_TTL=5m

# Observability (future)
# CYBEROS_METRICS_ADDR=:9090
# CYBEROS_TRACING_ENABLED=false
